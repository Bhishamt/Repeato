# Repeato environment
# Copy to .env and fill in. Never commit real secrets.

# --- Database --------------------------------------------------------------
# Local default: SQLite file. Use :memory: for throwaway runs.
DATABASE_PATH=./data/repeato.db
# Production: Set to a Postgres URL to use the Postgres driver instead (takes priority).
# For Supabase, use the pooled connection string (port 6543, pgbouncer/transaction mode) for the app.
# DATABASE_URL=postgres://repeato_app:<generated_password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# PG_POOL_MAX=10
# PG_SSL=require # options: disable, no-verify, require

# Canonical URL used in QR codes and marketing links (no trailing slash).
APP_URL=http://localhost:3000

# Seed script only. If ADMIN_PASSWORD is blank a random one is printed once.
ADMIN_EMAIL=admin@repeato.local
ADMIN_PASSWORD=
DEMO_PASSWORD=Repeato!2026

# --- Email Provider (Resend) -----------------------------------------------
# When configured, verification and password reset emails are delivered.
# Without them, links are logged to console (safe dev/test mode).
# RESEND_API_KEY=re_...
# MAIL_FROM=Repeato <no-reply@yourdomain.com>

# --- Rate limiting (Upstash Redis) -----------------------------------------
# Optional but recommended in production multi-node / serverless deployments.
# Limits are shared across instances via Upstash Redis REST API.
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=AX...

# --- Database Migration & Admin (Direct connection) ------------------------
# Direct connection (port 5432) used by scripts/migrate.mjs and scripts/verify-db-role.mjs
# ADMIN_DATABASE_URL=postgres://postgres:<admin_password>@db.yourproject.supabase.co:5432/postgres

# --- Tests -----------------------------------------------------------------
# Database used by the RLS suite (test/pg-rls.test.ts). Skipped when unset.
# PG_TEST_URL=postgres://postgres@127.0.0.1:55432/repeato_test

# --- Supabase API (Optional) -----------------------------------------------
# Only needed if you connect direct Supabase browser clients (PostgREST/storage).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
