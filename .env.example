# Repeato environment
# Copy to .env and fill in. Never commit real secrets.

# --- Database --------------------------------------------------------------
# Local default: SQLite file. Use :memory: for throwaway runs.
DATABASE_PATH=./data/repeato.db
# Set to a Postgres URL to use the Postgres driver instead (takes priority).
# DATABASE_URL=postgres://postgres:password@host:6543/postgres?pgbouncer=true

# Canonical URL used in QR codes and marketing links (no trailing slash).
APP_URL=http://localhost:3000

# Seed script only. If ADMIN_PASSWORD is blank a random one is printed once.
ADMIN_EMAIL=admin@repeato.local
ADMIN_PASSWORD=
DEMO_PASSWORD=Repeato!2026

# --- Rate limiting ---------------------------------------------------------
# Optional. With these set, limits are shared across instances (Upstash Redis
# REST). Without them each process keeps its own counters.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Tests -----------------------------------------------------------------
# Database used by the RLS suite (test/pg-rls.test.ts). Skipped when unset.
# PG_TEST_URL=postgres://postgres@127.0.0.1:55432/repeato_test

# --- Supabase --------------------------------------------------------------
# The app talks to Postgres directly through DATABASE_URL; these are only
# needed if you add a Supabase client (PostgREST, storage, auth).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
