# Repeato environment
# Copy to .env and fill in. Never commit real secrets.

# SQLite file used by the local app and tests. Use :memory: for throwaway runs.
DATABASE_PATH=./data/repeato.db

# Canonical URL used in QR codes and marketing links (no trailing slash).
APP_URL=http://localhost:3000

# Seed script only. If ADMIN_PASSWORD is blank a random one is printed once.
ADMIN_EMAIL=admin@repeato.local
ADMIN_PASSWORD=
DEMO_PASSWORD=Repeato!2026

# --- Production (Supabase) -------------------------------------------------
# Not read by the local SQLite runtime. Required only when you wire the
# Postgres adapter described in docs/DEPLOYMENT.md.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_DB_URL=
